{
  "compilerOptions": {
    "target": "ES2022",
    "module": "none",               // Запрещает генерировать exports / require
    "moduleResolution": "node",     // Помогает TS корректно искать типы
    "isolatedModules": false,       // Разрешает глобальные файлы без import/export
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  }
}